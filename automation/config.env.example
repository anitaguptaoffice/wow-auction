# 复制为 config.env 后按需修改（config.env 已加入 .gitignore）
#
# macOS：须为「运行脚本的终端」或「脚本本身」在
# 系统设置 → 隐私与安全性 → 辅助功能 中授权，否则无法向魔兽世界发送按键。

# 应用名称（用于 AppleScript activate / System Events）
WOW_APP_NAME="World of Warcraft"
BATTLE_NET_APP_NAME="Battle.net"

# 是否在开始时用 `open -a` 启动战网（0=否 1=是）
LAUNCH_BATTLE_NET=0
# 是否在战网之后启动魔兽（0=否 1=是；也可只开魔兽）
LAUNCH_WOW=0

# 启动后等待秒数（登录界面加载、选角进世界等由你自行把握，可加大）
DELAY_AFTER_LAUNCH=20

# 进入游戏后、执行按键序列前额外等待（秒）
DELAY_BEFORE_SEQUENCE=5

# 按键序列文件路径（相对本目录）
KEY_SEQUENCE_FILE="key-sequence.txt"

# 执行完序列后等待拍卖行 replicate 完成（秒）；过短可能未扫完就退出
DELAY_AFTER_SCAN=120

# 是否在结束时向游戏发送退出（见 key-sequence-exit.example.txt）
RUN_EXIT_SEQUENCE=0
EXIT_SEQUENCE_FILE="key-sequence-exit.txt"
