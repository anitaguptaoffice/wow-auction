ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
COPY backend/ /app/backend/
COPY deploy/ /app/deploy/
COPY frontend/public/wow-icons/ /app/icon-assets/
ENV PYTHONPATH=/app/backend:/app/deploy
USER 65534:65534
HEALTHCHECK NONE
CMD ["uvicorn", "sync_api:app_factory", "--factory", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--no-access-log"]
